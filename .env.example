# ---------------------------------------------------------------------------
# TRANSITIVE CONFIGURATION
# ---------------------------------------------------------------------------
# Your transitiverobotics.com username (or username on your self-hosted deployment)
TRANSITIVE_USER=your_transitive_username

# The JWT secret of the above user, from the Security page of the Portal
JWT_SECRET=your_jwt_secret_here

# Folder where deployment files, accounts, and sessions are stored
TRANSACT_VAR_DIR=/var/lib/transact

# ---------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ---------------------------------------------------------------------------
# AWS & COGNITO CONFIGURATION
# ---------------------------------------------------------------------------
AWS_REGION=eu-south-2
COGNITO_USER_POOL_ID=region_poolid
COGNITO_ISSUER_URL=https://cognito-idp.region.amazonaws.com/region_poolid
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_CLIENT_SECRET=your_cognito_client_secret
COGNITO_DOMAIN=your_cognito_domain.auth.region.amazoncognito.com

# ---------------------------------------------------------------------------
# SESSION & SECURITY
# ---------------------------------------------------------------------------
# Secret used by express-session (generate a strong random string)
TRANSACT_SESSION_SECRET=generate_a_strong_random_string_here

# ---------------------------------------------------------------------------
# REDIRECT URIS (OAUTH CALLBACKS)
# ---------------------------------------------------------------------------
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
COGNITO_LOGOUT_URI=http://localhost:5173/
POST_LOGIN_REDIRECT_URL=http://localhost:5173/
